{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "underlod-logging",
	"main": "src/index.ts",
	"compatibility_date": "2026-06-05",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
	// R2 bucket binding. Create the bucket once with:
	//   wrangler r2 bucket create underlod-crashes
	"r2_buckets": [
		{
			"binding": "CRASHES",
			"bucket_name": "underlod-crashes"
		}
	]
	// Secrets (never commit these — they're configured server-side):
	//   wrangler secret put DASHBOARD_TOKEN
	//     (pick a long random string; paste into the dashboard once on load)
}
