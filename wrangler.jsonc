{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "underlod-logging",
	"main": "src/index.ts",
	"compatibility_date": "2026-06-05",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	]
	// Secrets (set via `wrangler secret put`, never committed):
	//   wrangler secret put DASHBOARD_TOKEN   <- gates /events read endpoint
	//   wrangler secret put TURSO_URL         <- libsql://<db>-<org>.turso.io
	//   wrangler secret put TURSO_TOKEN       <- DB auth token from `turso db tokens create`
}
